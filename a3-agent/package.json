{
  "name": "a3-hybrid-router",
  "version": "0.1.0",
  "private": true,
  "description": "CSCI 599 A3 — hybrid local/cloud LLM router plugin for OpenClaw",
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "volta": {
    "node": "24.22.1"
  },
  "openclaw": {
    "extensions": [
      "./src/plugin/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "peerDependencies": {
    "openclaw": "2026.10.9"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "eslint": "9.38.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "3.2.4"
  }
}
