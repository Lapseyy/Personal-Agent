# Placeholders only. Real values live in Secret Manager / Cloud Run env, never in git.

# --- Router (non-secret) ---
A3_LOCAL_PROVIDER=ollama
A3_LOCAL_MODEL=gemma4:e4b
A3_CLOUD_PROVIDER=openai
A3_CLOUD_MODEL=gpt-5.6-sol
A3_OLLAMA_BASE_URL=http://127.0.0.1:11435
A3_HEALTH_TIMEOUT_MS=3000
A3_CLOUD_COOLDOWN_MS=300000
# Rate-limit simulation (reversible, burns no quota): set to 1, or create the flag file.
A3_SIMULATE_CLOUD_429=0
A3_RATE_LIMIT_FLAG_FILE=/mnt/agent-state/flags/simulate-429
A3_LOCAL_COOLDOWN_MS=300000

# --- Email / calendar (non-secret) ---
# Extra addresses the agent may email, separated by commas, semicolons or spaces.
# The test account itself is always allowed.
A3_EMAIL_ALLOWLIST=
GOG_HOME=/home/node/.openclaw/gogcli
GOG_KEYRING_BACKEND=file

# --- Secrets (Secret Manager; values shown are fake) ---
TELEGRAM_BOT_TOKEN=replace-me
TAILSCALE_AUTHKEY=replace-me
OPENCLAW_GATEWAY_TOKEN=replace-me-at-least-16-chars
GOG_KEYRING_PASSWORD=replace-me
GOG_ACCOUNT=test-account@example.com
