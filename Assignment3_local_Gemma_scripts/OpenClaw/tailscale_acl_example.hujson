// Source: Assignment3_local_Gemma.pdf, Part 2, step 2.
// Relevant parts of the Tailscale policy file (Access controls -> JSON editor). Comments are allowed there.
// 100.101.102.103 is an example: use your laptop's tailnet IP (tailscale ip -4).
{
  "tagOwners": {
    "tag:a3-agent": ["autogroup:admin"]
  },
  "grants": [
    // you and your own devices, as before
    {"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]},

    // cloud agent -> your laptop's Ollama only (you probably have this already)
    {"src": ["tag:a3-agent"], "dst": ["100.101.102.103"], "ip": ["tcp:11434"]},

    // NEW: you and shared-in graders -> the agent's dashboard only
    {"src": ["autogroup:member", "autogroup:shared"], "dst": ["tag:a3-agent"], "ip": ["tcp:443"]}
  ]
}
